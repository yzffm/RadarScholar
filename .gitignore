# =============================================================================
# RadarScholar .gitignore
# =============================================================================

# --- Environment & Secrets ---
.env
.env.local
.env.production
*.pem
.agents/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
.venv/
env/
*.whl
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Local Database (SQLite dev) ---
*.db
*.sqlite
*.sqlite3

# --- Flutter / Dart ---
frontend/.dart_tool/
frontend/.packages
frontend/.pub/
frontend/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/*.iml

# --- Android ---
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/**/GeneratedPluginRegistrant.java
frontend/android/key.properties
frontend/android/**/*.keystore
frontend/android/**/*.jks

# --- iOS ---
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/Flutter/Flutter.framework
frontend/ios/Flutter/Flutter.podspec
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/app.flx
frontend/ios/Flutter/flutter_export_environment.sh
frontend/ios/ServiceDefinitions.json
frontend/ios/Runner/GeneratedPluginRegistrant.*

# --- Web ---
frontend/web/favicon.png.bak

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Misc ---
*.log
*.tmp
*.bak
