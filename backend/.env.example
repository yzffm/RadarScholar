# =============================================================================
# RadarScholar Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=RadarScholar
APP_VERSION=0.1.0
DEBUG=True

# --- Database ---
# PostgreSQL connection string for SQLAlchemy
DATABASE_URL=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Providers ---
# Gemini (primary)
GEMINI_API_KEY=

# Groq (fallback)
GROQ_API_KEY=
